  "payout": {
    "speed_base": 0.6,
    "speed_bonus": 0.4,
    "quality_base": 0.5,
    "quality_bonus": 0.5,
    "multi_step": 0.15,
    "protocol_mult": { "TCP": 1.15, "UDP": 1.0 },
    "udp_time_mult": 0.8,
    "streak_step": 0.02,
    "streak_cap": 10,
    "money_mult_step": 0.05,
    "formula": "payout = int(round(float(base_sum) * speed * quality * multi * protocol * streak * money_mult))",
    "speed_formula": "speed = 0.6 + 0.4 * clamp(time_left / timer_total, 0, 1)",
    "quality_formula": "quality = 0.5 + 0.5 * q",
    "multi_formula": "multi = 1 + 0.15 * (n - 1)",
    "streak_formula": "streak = 1 + 0.02 * min(10, streak)",
    "money_mult_formula": "money_mult = 1 + 0.05 * money_level",
    "note": "Только float-арифметика: никаких int/int и никакого ^ для степени."
  },
